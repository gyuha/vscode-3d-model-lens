{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": ["node", "mocha"]
  },
  "include": ["src", "test", "esbuild.mjs", "scripts", "vitest.config.ts", ".vscode-test.mjs", "playwright.config.ts"],
  "exclude": [".vscode-test", "dist", "out", "node_modules", "playwright-report", "test-results"]
}
