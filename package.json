{
  "name": "vscode-3d-model-lens",
  "displayName": "3D Model Lens",
  "description": "View glTF / GLB / STL models and measure their dimensions inside VS Code",
  "icon": "images/icon.png",
  "version": "0.5.0",
  "publisher": "nicegyuha",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gyuha/vscode-3d-model-lens.git"
  },
  "homepage": "https://github.com/gyuha/vscode-3d-model-lens",
  "bugs": {
    "url": "https://github.com/gyuha/vscode-3d-model-lens/issues"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "3d",
    "gltf",
    "glb",
    "stl",
    "viewer",
    "babylon",
    "measure"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "npm run build && vscode-test",
    "fixtures": "node scripts/gen-fixtures.mjs",
    "package": "npm run build && npm run check:bundle && vsce package --no-dependencies",
    "vscode:prepublish": "npm run build",
    "gen:gltf-extensions": "node scripts/gen-gltf-extensions.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "uat": "npm run build && npm run uat:build && npm run uat:serve",
    "uat:build": "esbuild src/webviewHtml.ts --bundle --platform=node --format=esm --outfile=out/uat/webviewHtml.mjs --log-level=error",
    "uat:serve": "node scripts/uat-serve.mjs",
    "test:e2e": "npm run build && npm run uat:build && playwright test"
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "modelLens.viewer",
        "displayName": "3D Model Lens",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "*.gltf"
          },
          {
            "filenamePattern": "*.glb"
          },
          {
            "filenamePattern": "*.stl"
          }
        ]
      }
    ],
    "configuration": {
      "title": "3D Model Lens",
      "properties": {
        "modelLens.background": {
          "type": "string",
          "enum": [
            "theme",
            "light",
            "dark"
          ],
          "enumDescriptions": [
            "Follows the VS Code editor background color.",
            "Pins a light background (#ffffff).",
            "Pins a dark background (#1f1f1f)."
          ],
          "default": "theme",
          "markdownDescription": "Viewer background mode. Changing it from the viewer panel saves it here and applies to every open viewer immediately. For why `light` is pure white rather than a light gray, see the measurements in ADR `260822-195326`."
        },
        "modelLens.grid": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show the ground grid in the viewer. Toggling it from the viewer panel saves it here and applies to every open viewer immediately."
        },
        "modelLens.inspectorOnStart": {
          "type": "boolean",
          "default": false,
          "description": "Start with the Babylon Inspector open when a model is opened."
        },
        "modelLens.unit": {
          "type": "string",
          "enum": [
            "auto",
            "mm",
            "cm",
            "m",
            "in"
          ],
          "enumDescriptions": [
            "Infer from the format — meters for glTF/GLB, unitless (plain numbers) for STL.",
            "1 model unit = 1 mm",
            "1 model unit = 1 cm",
            "1 model unit = 1 m",
            "1 model unit = 1 in"
          ],
          "default": "auto",
          "markdownDescription": "**Initial** unit shown for dimensions and measurements. You can change it per file from the viewer panel, and that choice is remembered. The unit only changes the displayed label — no geometry is transformed."
        },
        "modelLens.decimals": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "maximum": 10,
          "description": "Number of decimal places for dimensions and measurements."
        }
      }
    },
    "capabilities": {
      "untrustedWorkspaces": {
        "supported": true
      }
    },
    "commands": [
      {
        "command": "modelLens.toggleInspector",
        "title": "Toggle Inspector",
        "category": "3D Model Lens",
        "icon": "$(inspect)"
      },
      {
        "command": "modelLens.toggleMeasureMode",
        "title": "Toggle Measure Mode",
        "category": "3D Model Lens",
        "icon": "$(gist)"
      },
      {
        "command": "modelLens.togglePanel",
        "title": "Toggle Viewer Panel",
        "category": "3D Model Lens",
        "icon": "$(layout-sidebar-right)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "modelLens.toggleMeasureMode",
          "when": "activeCustomEditorId == 'modelLens.viewer'",
          "group": "navigation@0"
        },
        {
          "command": "modelLens.toggleInspector",
          "when": "activeCustomEditorId == 'modelLens.viewer'",
          "group": "navigation@1"
        },
        {
          "command": "modelLens.togglePanel",
          "when": "activeCustomEditorId == 'modelLens.viewer'",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "modelLens.toggleInspector",
          "when": "activeCustomEditorId == 'modelLens.viewer'"
        },
        {
          "command": "modelLens.toggleMeasureMode",
          "when": "activeCustomEditorId == 'modelLens.viewer'"
        },
        {
          "command": "modelLens.togglePanel",
          "when": "activeCustomEditorId == 'modelLens.viewer'"
        }
      ]
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.2.0",
    "@types/vscode": "~1.96",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@babylonjs/core": "^9.22.1",
    "@babylonjs/inspector": "^9.22.1",
    "@babylonjs/loaders": "^9.22.1"
  }
}
